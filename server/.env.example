# Copy to .env for local development. Never commit .env.
PORT=8080

# Google Gemini powers the live AI co-founder (free key: https://aistudio.google.com/apikey).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Safety limit on AI requests per day across all users.
AI_DAILY_LIMIT=300

# Optional: MongoDB enables accounts and cloud-saved projects.
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated origins allowed to call the API cross-site (same-origin needs nothing).
CLIENT_ORIGIN=https://ranjansaurabh03.github.io,http://localhost:5173

# Copy to .env for local development. Never commit .env.
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/ai_cofounder
JWT_SECRET=replace-with-a-long-random-string
# Comma-separated origins allowed to call the API (the deployed site + local dev).
CLIENT_ORIGIN=https://ranjansaurabh03.github.io,http://localhost:5173

# Optional: enables the Claude-powered co-founder chat.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Safety limit on AI requests per day across all users (protects your API credit).
AI_DAILY_LIMIT=300
